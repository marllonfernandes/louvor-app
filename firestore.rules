rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Funções utilitárias de validação e IAM
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUserDocAdmin(uid) {
      // Checa se o usuário atual tem systemRole == 'Admin' no cadastro de users
      return get(/databases/$(database)/documents/users/$(uid)).data.systemRole == 'Admin';
    }

    function isAdmin() {
      return isAuthenticated() && isUserDocAdmin(request.auth.uid);
    }

    function isSelf(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidString(str, minLen, maxLen) {
      return str is string && str.size() >= minLen && str.size() <= maxLen;
    }

    function isNonEmptyMap(m) {
      return m is map;
    }

    // ==========================================
    // 0. Coleção: users (Membros e permissões)
    // ==========================================
    match /users/{userId} {
      // Qualquer pessoa autenticada pode ler os dados de outros membros (para listar equipe)
      allow read: if isAuthenticated();
      
      // Apenas o próprio usuário pode editar seu perfil (ou o Admin)
      // Nota: Não pode se auto-promover a Admin se não for Admin
      allow update: if (isSelf(userId) && request.resource.data.systemRole == resource.data.systemRole) || isAdmin();
      
      // Criação inicial por um Admin (convite) ou pelo usuário aceitando o convite
      allow create: if isAdmin() || (
        isSelf(userId) && 
        request.resource.data.systemRole == get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.systemRole
      );
      allow delete: if isAdmin();
    }

    // Compatibilidade com coleção antiga 'members' - Migrar dados para 'users'
    match /members/{memberId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin(); // Congelada para edições comuns, migrar aos poucos
    }

    // ==========================================
    // 1. Coleção: events (Escalas e Cultos)
    // ==========================================
    match /events/{eventId} {
      allow read: if isAuthenticated();
      
      // Criar e deletar apenas admin
      allow create, delete: if isAdmin();

      // Update: Admin pode tudo. Membro pode apenas atualizar sua própria presença.
      // Para saber se ele está mudando SÓ a presença dele, verificamos se os diffs são apenas no seu ID dentro do mapa 'confirmed'
      allow update: if isAdmin() 
        || (
          isAuthenticated() 
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['confirmed'])
          // Idealmente checaríamos a key dentro do mapa, mas o hasOnly na raiz garante que o resto do evento não mudou.
        );
    }

    // ==========================================
    // 2. Coleção: songs (Repertório de Músicas)
    // ==========================================
    match /songs/{songId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // ==========================================
    // 3. Coleção: teams (Equipes de Louvor)
    // ==========================================
    match /teams/{teamId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // ==========================================
    // 4. Coleção: adoption_songs (Sugestões & Votação)
    // ==========================================
    match /adoption_songs/{songId} {
      allow read: if isAuthenticated();
      
      // Qualquer um autenticado pode sugerir música
      allow create: if isAuthenticated() && isValidString(request.resource.data.title, 1, 150);
      
      allow delete: if isAdmin();

      // Update: Admin pode alterar status/aprovar. Membros podem apenas votar.
      allow update: if isAdmin()
        || (
          isAuthenticated()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes'])
        );
    }
  }
}
