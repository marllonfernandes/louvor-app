rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Funções utilitárias de validação
    function isValidString(str, minLen, maxLen) {
      return str is string && str.size() >= minLen && str.size() <= maxLen;
    }

    function isNonEmptyMap(m) {
      return m is map;
    }

    // ==========================================
    // 1. Coleção: events (Escalas e Cultos)
    // ==========================================
    match /events/{eventId} {
      allow read: if true;
      allow create, update: if isValidString(request.resource.data.title, 1, 150)
                            && request.resource.data.date is string
                            && request.resource.data.time is string
                            && isNonEmptyMap(request.resource.data.confirmed);
      allow delete: if true;
    }

    // ==========================================
    // 2. Coleção: songs (Repertório de Músicas)
    // ==========================================
    match /songs/{songId} {
      allow read: if true;
      allow create, update: if isValidString(request.resource.data.title, 1, 150)
                            && isValidString(request.resource.data.artist, 1, 100)
                            && isValidString(request.resource.data.key, 1, 10);
      allow delete: if true;
    }

    // ==========================================
    // 3. Coleção: members (Integrantes e Músicos)
    // ==========================================
    match /members/{memberId} {
      allow read: if true;
      allow create, update: if isValidString(request.resource.data.name, 1, 100)
                            && isValidString(request.resource.data.role, 1, 80);
      allow delete: if true;
    }

    // ==========================================
    // 4. Coleção: teams (Equipes de Louvor)
    // ==========================================
    match /teams/{teamId} {
      allow read: if true;
      allow create, update: if isValidString(request.resource.data.name, 1, 100)
                            && request.resource.data.members is list;
      allow delete: if true;
    }
  }
}
